{
  "name": "pr-review-handler-monorepo",
  "private": true,
  "description": "Monorepo for pr-review-handler agent skill. See packages/ for the published npm packages.",
  "author": "trashcodemaker",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync": "node scripts/sync-skill.mjs packages/core && node scripts/sync-skill.mjs packages/pi --name pi-pr-review-handler",
    "sync:core": "node scripts/sync-skill.mjs packages/core",
    "sync:pi": "node scripts/sync-skill.mjs packages/pi --name pi-pr-review-handler",
    "publish:core": "npm publish --workspace packages/core --access public",
    "publish:pi": "npm publish --workspace packages/pi --access public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JI4JUN/pr-review-handler.git"
  },
  "homepage": "https://github.com/JI4JUN/pr-review-handler#readme",
  "bugs": {
    "url": "https://github.com/JI4JUN/pr-review-handler/issues"
  }
}
